target/

# Environment files (contains secrets)
.env
.env.local
.env.*.local

# Docker and deployment files
docker-compose.override.yml

# Eclipse / JDT language server settings
.settings/

# Node (not a Node project; ignore any accidental npm artifacts)
node_modules/
package.json
package-lock.json

# Claude Code local settings (session-specific, not meant to be shared)
.claude/settings.local.json

# Pre-publication audit notes: catalogue the sensitive strings they exist to
