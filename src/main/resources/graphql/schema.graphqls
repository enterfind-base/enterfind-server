scalar Long

type Query {
    about: About!
    availableTreatments: [TreatmentInfo!]!
    dataSources(token: String): [DataSource!]!
    dataSource(token: String, name: String!, type: DataSourceType!): DataSource
    dataSourceStats(token: String, name: String!, type: DataSourceType!): DataSourceStats
    dataSourceTreatments(token: String, dataSourceName: String!, dataSourceType: DataSourceType!): [DataSourceTreatment!]!
    testDataSource(token: String, name: String!, type: DataSourceType!): TestDataSourceResult!
    """
    Search for items. All supplied filters are ANDed together.

    `name` and `folder` match the item's own name and path directly, as substrings.
    `searchConditions` filter on treatment-produced attributes. `searchString` searches
    every attribute at once — see its own description for how the two differ.
    """
    search(
        token: String,
        searchConditions: [SearchConditionInput!],
        "Substring match on the item's own file name."
        name: String,
        "Substring match on the item's own folder path."
        folder: String,
        """
        Free-text search across **every** attribute of an item, in both metadata and
        document text.

        Whitespace separates terms, and a term wrapped in double quotes is a phrase. An
        item matches when **every** term is found somewhere on it — each term may be
        satisfied from metadata or from document text independently of where the others
        were found, so `invoice 2024` matches a file named `invoice.pdf` whose text
        mentions 2024.

        This is the scope difference from a `LIKE` condition, which requires its terms to
        share one value of one named key.

        Unquoted terms are **prefix**-matched against document text: `distribut` finds
        "distributed" and "distribution". Prefix matching is deliberately not available on
        `LIKE` conditions, which are exact field filters rather than a type-ahead box.

        Quote a term to require it contiguous and in order. Quoting is the only way to ask
        for adjacency, and it is the expensive option — a common phrase can take seconds.

        Limits worth knowing:
        * A term of one or two characters matches **document text only**, not metadata. No
          index can serve so short a pattern against metadata.
        * There is no mid-token substring search in document text; `tribut` finds nothing.
          Use a prefix instead.

        Operators are not supported: `( ) & | ! : * < > ' \\` are rejected.
        """
        searchString: String,
        skip: Int,
        howmany: Int,
        sortDirection: SortDirection): SearchResult!
    itemAttributes(token: String, dataSourceName: String!, dataSourceType: DataSourceType!, name: String!, folder: String, keyNames: [String!]): [ItemAttribute!]!
    itemAttributeKeys(token: String): [String!]!
    """
    Attribute keys present on the items matching these filters. Filters have exactly the
    same meaning as on `search`.
    """
    availableItemAttributeKeys(
        token: String,
        searchConditions: [SearchConditionInput!],
        name: String,
        folder: String,
        """
        Free-text search across **every** attribute of an item, in both metadata and
        document text.

        Whitespace separates terms, and a term wrapped in double quotes is a phrase. An
        item matches when **every** term is found somewhere on it — each term may be
        satisfied from metadata or from document text independently of where the others
        were found, so `invoice 2024` matches a file named `invoice.pdf` whose text
        mentions 2024.

        This is the scope difference from a `LIKE` condition, which requires its terms to
        share one value of one named key.

        Unquoted terms are **prefix**-matched against document text: `distribut` finds
        "distributed" and "distribution". Prefix matching is deliberately not available on
        `LIKE` conditions, which are exact field filters rather than a type-ahead box.

        Quote a term to require it contiguous and in order. Quoting is the only way to ask
        for adjacency, and it is the expensive option — a common phrase can take seconds.

        Limits worth knowing:
        * A term of one or two characters matches **document text only**, not metadata. No
          index can serve so short a pattern against metadata.
        * There is no mid-token substring search in document text; `tribut` finds nothing.
          Use a prefix instead.

        Operators are not supported: `( ) & | ! : * < > ' \\` are rejected.
        """
        searchString: String): [String!]!
    standardFields: [String!]!
    """
    Value counts for one attribute key across the items matching these filters. Filters
    have exactly the same meaning as on `search`.
    """
    getFacets(
        token: String,
        "Attribute key to break down by."
        key: String!,
        searchConditions: [SearchConditionInput!],
        name: String,
        folder: String,
        """
        Free-text search across **every** attribute of an item, in both metadata and
        document text.

        Whitespace separates terms, and a term wrapped in double quotes is a phrase. An
        item matches when **every** term is found somewhere on it — each term may be
        satisfied from metadata or from document text independently of where the others
        were found, so `invoice 2024` matches a file named `invoice.pdf` whose text
        mentions 2024.

        This is the scope difference from a `LIKE` condition, which requires its terms to
        share one value of one named key.

        Unquoted terms are **prefix**-matched against document text: `distribut` finds
        "distributed" and "distribution". Prefix matching is deliberately not available on
        `LIKE` conditions, which are exact field filters rather than a type-ahead box.

        Quote a term to require it contiguous and in order. Quoting is the only way to ask
        for adjacency, and it is the expensive option — a common phrase can take seconds.

        Limits worth knowing:
        * A term of one or two characters matches **document text only**, not metadata. No
          index can serve so short a pattern against metadata.
        * There is no mid-token substring search in document text; `tribut` finds nothing.
          Use a prefix instead.

        Operators are not supported: `( ) & | ! : * < > ' \\` are rejected.
        """
        searchString: String): [FacetValue!]!

    # User settings
    userSetting(token: String, settingName: String!): UserSetting
    userSettings(token: String): [UserSetting!]!
    aiSettings(token: String): [UserSetting!]!
    aiProvider(token: String): AiProvider!

    # Face embedding model (instance-global; lives in SYSTEM_SETTINGS, not exposed via userSettings)
    faceEmbeddingModel(token: String): FaceEmbeddingModelStatus!

    # Authentication
    isAuthenticationRequired: Boolean!
    currentUser(token: String): HumanUser
    humanUsers(token: String): [HumanUser!]!
    humanUser(token: String, id: String!): HumanUser
    userSetup(token: String!): UserSetupInfo
    
    # API Keys
    apiUsers(token: String): [ApiUser!]!
    apiUser(token: String, id: String!): ApiUser

    # Saved Queries
    savedQueries(token: String): [SavedQuery!]!
    savedQuery(token: String, id: String!): SavedQuery

    # Remote Access
    remoteAccessConfig(token: String): RemoteAccessConfig!
    remoteUsage(token: String!): [UsageEntry!]!
    remoteQuota(token: String!): RemoteQuota
}

type Mutation {
    createLocalFileSystemDataSource(token: String, input: CreateLocalFileSystemDataSourceInput!): LocalFileSystemDataSource!
    createRemoteFileSystemDataSource(token: String, input: CreateRemoteFileSystemDataSourceInput!): RemoteFileSystemDataSource!
    createS3BucketDataSource(token: String, input: CreateS3BucketDataSourceInput!): S3BucketDataSource!
    updateLocalFileSystemDataSource(token: String, name: String!, input: UpdateLocalFileSystemDataSourceInput!): LocalFileSystemDataSource
    updateRemoteFileSystemDataSource(token: String, name: String!, input: UpdateRemoteFileSystemDataSourceInput!): RemoteFileSystemDataSource
    updateS3BucketDataSource(token: String, name: String!, input: UpdateS3BucketDataSourceInput!): S3BucketDataSource
    deleteDataSource(token: String, name: String!, type: DataSourceType!): Boolean!
    clearDataSourceData(token: String, name: String!, type: DataSourceType!): Int!
    scanDataSource(token: String, name: String!, type: DataSourceType!): DataSource
    addDataSourceTreatment(token: String, input: AddDataSourceTreatmentInput!): DataSourceTreatment!
    removeDataSourceTreatment(token: String, dataSourceName: String!, dataSourceType: DataSourceType!, treatment: TreatmentType!): Boolean!
    updateDataSourceTreatmentConfig(token: String, input: UpdateDataSourceTreatmentConfigInput!): DataSourceTreatment

    # Set or update a user setting
    setUserSetting(token: String, settingName: String!, value: String!): UserSetting!
    setAiSetting(token: String, settingName: String!, value: String!): UserSetting!

    # Set the instance-global face embedding model. For CUSTOM, url is fetched and probed inline and
    # a model that fails is never stored; for BUILTIN, nonCommercialAck must be true. Throws (leaving
    # the previous selection in force) on any failure.
    setFaceEmbeddingModel(token: String, mode: String!, url: String, nonCommercialAck: Boolean): FaceEmbeddingModelStatus!
    # Sets the grouping threshold AND re-clusters every stored face at it. No re-embedding: the
    # vectors are unchanged, only how they are clustered.
    setFaceGroupingThreshold(token: String, threshold: Float!): FaceEmbeddingModelStatus!

    # Rename a detected-face group label (updates the group and every detectedface result carrying it)
    renameFaceLabel(token: String, oldLabel: String!, newLabel: String!): Boolean!

    # AI Helper operations (multi-provider)
    testAiConnection(token: String): Boolean!
    interpretCronExpression(token: String, naturalLanguageInput: String!): CronInterpretation
    explainCronExpression(token: String, cronExpression: String!): CronExplanation
    interpretSkipPattern(token: String, naturalLanguageInput: String!): SkipPatternInterpretation
    explainSkipPattern(token: String, skipPattern: String!): SkipPatternExplanation
    interpretSearchQuery(token: String, input: AiSearchInterpretationInput!): AiSearchInterpretation!

    # Authentication
    login(input: LoginInput!): AuthResult!
    loginWithRecoveryCode(input: RecoveryLoginInput!): AuthResult!
    loginWithApiKey(input: LoginWithApiKeyInput!): AuthResult!
    logout(token: String): Boolean!
    createHumanUser(token: String, input: CreateHumanUserInput!): UserCreationResult!
    updateHumanUser(token: String, input: UpdateHumanUserInput!): HumanUser!
    deleteHumanUser(token: String, id: String!): Boolean!
    regenerateTotpSecret(token: String, id: String!): TotpSetup!
    regenerateRecoveryCodes(token: String, id: String!): RecoveryCodesResult!
    regenerateSetupToken(token: String, userId: String!): UserCreationResult!
    
    # API Keys
    createApiUser(token: String, input: CreateApiUserInput!): ApiUserCreationResult!
    deleteApiUser(token: String, id: String!): Boolean!

    # Saved Queries
    createSavedQuery(token: String, input: CreateSavedQueryInput!): SavedQuery!
    deleteSavedQuery(token: String, id: String!): Boolean!

    # Remote Access
    """
    Enables or disables remote access.

    Without inviteCode this switches the tunnel on or off using the stored credential, so the Server
    ID survives switching off and on. With inviteCode (only valid with enabled: true) the instance
    enrolls afresh: the code is presented on one connection attempt, and if the tunnel accepts it,
    the credential it issues replaces the stored one under a new Server ID. A code that is not
    accepted leaves the stored credential in place. The outcome arrives asynchronously — watch
    remoteAccessConfigUpdates for the new serverId or a statusMessage.
    """
    setRemoteAccessEnabled(
        token: String,
        enabled: Boolean!,
        "A single-use invite code (efi_…). Never stored; re-enter it if the attempt fails."
        inviteCode: String
    ): RemoteAccessConfig!
    reenrollRemoteAccess(token: String): RemoteAccessConfig!

    # Item management
    deleteItem(token: String, dataSourceName: String!, dataSourceType: DataSourceType!, name: String!, folder: String): Boolean!
}

type Subscription {
    dataSourceStatsUpdates(token: String, name: String!, type: DataSourceType!, intervalSeconds: Int = 5): DataSourceStats!
    remoteAccessConfigUpdates(token: String): RemoteAccessConfig!
}

