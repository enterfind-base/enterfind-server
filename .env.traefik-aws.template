# ===========================================
# Enterfind Server Docker Compose Configuration
# ===========================================

# ===========================================
# Application Configuration
# ===========================================
DOMAIN=example.com
SPRING_PROFILE=beta

# Docker Registry (your own private registry hosting the enterfind-server image).
# For a public install, use the GHCR image instead - see docs/installation.md.
REGISTRY_URL=your-registry.example.com

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=enterfind
DB_USER=enterfind
DB_PASSWORD=your_secure_database_password_here

# ===========================================
# Encryption Configuration
# ===========================================
# AES-256 encryption key for datasource credentials (base64 encoded, 32 bytes)
# Generate with: openssl rand -base64 32
# If not set, credentials are stored in plaintext
ENTERFIND_ENCRYPTION_KEY=

# ===========================================
# SSL/TLS Configuration (Let's Encrypt)
# ===========================================
ACME_EMAIL=admin@example.com

# ===========================================
# AWS Route53 Configuration (for DNS challenge)
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_HOSTED_ZONE_ID=your_hosted_zone_id_here

# ===========================================
# Traefik Dashboard Authentication
# ===========================================
# Generate with: htpasswd -nb admin password
TRAEFIK_AUTH=your_user:your_bcrypt_hash_here

# ===========================================
# Watchtower Configuration
# ===========================================
WATCHTOWER_INTERVAL=3600  # Check for updates every hour (in seconds)

# ===========================================
# Security Notes
# ===========================================
# 1. Change all default passwords
# 2. Use strong, unique passwords for each service
# 3. Keep this file secure and never commit it to version control
# 4. Consider using Docker secrets for sensitive data in production