# ===========================================
# Enterfind Minimal Deployment Configuration
# (app + Postgres only - see docker-compose.minimal.yml)
# ===========================================

# ===========================================
# Database Configuration
# ===========================================
# Shared by both the postgres and enterfind services - must match.
DB_PASSWORD=change-me

# ===========================================
# Encryption Configuration
# ===========================================
# AES-256 encryption key for datasource credentials (base64 encoded, 32 bytes)
# Generate with: openssl rand -base64 32
# If not set, credentials are stored in plaintext.
ENTERFIND_ENCRYPTION_KEY=

# ===========================================
# Security Notes
# ===========================================
# 1. Change DB_PASSWORD from the default above
# 2. Keep this file secure and never commit it to version control
